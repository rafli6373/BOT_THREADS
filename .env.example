# ========================================================
# PENGATURAN AI (GROQ & NVIDIA)
# ========================================================
# Provider utama yang digunakan: "groq" atau "nvidia"
AI_PROVIDER=groq

# GROQ MULTI-API KEY (Mendukung banyak key dipisahkan tanda koma untuk rotasi otomatis)
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3,gsk_key4,gsk_key5
GROQ_MODEL=qwen/qwen3.8-27b

# NVIDIA NIM API (build.nvidia.com)
NVIDIA_API_KEY=nvapi-xxxx
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Fallback otomatis jika provider utama error/limit (true/false)
ENABLE_FALLBACK=true

# ========================================================
# PENGATURAN TARGET USERNAME & THREADS API
# ========================================================
# Target siapa saja yang dibalas oleh AI (* = semua orang)
TARGET_USERS=*

# Username akun Threads kamu (tanpa tanda @)
BOT_USERNAME=username_threads_kamu

# Token Akses Threads (Long-Lived 60 Hari dari Meta Developer)
THREADS_ACCESS_TOKEN=THAGI_TOKEN_ANDA_DISINI

# Interval polling dalam detik
CHECK_INTERVAL_SECONDS=30

# (Opsional) Custom Persona / System Prompt
# SYSTEM_PROMPT="Anda adalah asisten pakar..."
